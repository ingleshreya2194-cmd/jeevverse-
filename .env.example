# Browser-local demo mode is the default; no Supabase project is required.
VITE_WORKSPACE_MODE=demo

# Optional: set mode to "supabase" and provide both public values for shared live data.
# VITE_WORKSPACE_MODE=supabase
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
